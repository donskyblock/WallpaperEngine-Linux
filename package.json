{
  "name": "wpe-scaffold",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run license:check",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "wpe": "WEBKIT_DISABLE_COMPOSITING_MODE=1 tauri dev",
    "fresh": "WEBKIT_DISABLE_COMPOSITING_MODE=1 tauri dev -- -- --onboarding",
    "fetch-lwe": "bash scripts/fetch-lwe.sh",
    "install-app": "bash scripts/install.sh",
    "uninstall-app": "bash scripts/uninstall.sh",
    "update-app": "bash scripts/update.sh",
    "license:gen": "bash scripts/gen-license.sh",
    "license:check": "bash scripts/gen-license.sh --check"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "lucide-react": "^1.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
